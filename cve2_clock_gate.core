name: "openhwgroup:cve2:cve2_clock_gate:0.1"
description: "Clock gate used on CVE2 toplevel"
filesets:

  files_rtl:
    files:
      - rtl/cve2_clock_gate.sv
    file_type: systemVerilogSource
  
  files_synth:
    depend:
      - polito:cve2:prim-tsmc65

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine
    default: false

targets:
  default:
    filesets:
      - "!target_asic_synthesis ? (files_rtl)"
      - "target_asic_synthesis ? (files_synth)"
